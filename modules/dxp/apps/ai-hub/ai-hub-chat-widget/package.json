{
	"dependencies": {
		"eventsource": "^4.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"description": "AI Hub Chat Widget for CDN deployment",
	"devDependencies": {
		"@types/react": "18.3.18",
		"@types/react-dom": "18.3.5",
		"esbuild": "0.24.2",
		"typescript": "5.7.3"
	},
	"name": "ai-hub-chat-widget",
	"private": true,
	"scripts": {
		"build": "esbuild src/widget.tsx --bundle --minify --outfile=dist/widget.min.js --format=iife",
		"build:dev": "esbuild src/widget.tsx --bundle --outfile=dist/widget.js --format=iife --sourcemap",
		"dev": "npm run build:dev && node dev-server.mjs",
		"typecheck": "tsc --noEmit"
	},
	"version": "1.0.0"
}
